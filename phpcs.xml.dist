<?xml version="1.0"?>
<ruleset name="infiRewards">
	<description>Coding standards for the infiRewards plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Project code is intentionally concise; security and escaping sniffs remain enabled. -->
	<rule ref="Squiz.Commenting"><severity>0</severity></rule>
	<rule ref="Generic.Commenting"><severity>0</severity></rule>
	<rule ref="PEAR.Functions.FunctionCallSignature"><severity>0</severity></rule>
	<rule ref="Squiz.ControlStructures.ControlSignature.NewlineAfterOpenBrace"><severity>0</severity></rule>
	<rule ref="Universal.Operators.DisallowShortTernary"><severity>0</severity></rule>
	<rule ref="WordPress.Arrays.ArrayDeclarationSpacing"><severity>0</severity></rule>
	<rule ref="WordPress.WP.I18n.MissingTranslatorsComment"><severity>0</severity></rule>
	<!-- Table-name helpers return only the WordPress-prefixed plugin tables. -->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"><severity>0</severity></rule>
	<config name="testVersion" value="7.4-"/>

	<rule ref="Generic.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>
</ruleset>
